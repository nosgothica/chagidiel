{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chagidiel",
  "main": "src/Index.js",
  "compatibility_date": "2026-09-06",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [
      { "name": "CAMPAIGNS", "class_name": "CampaignRoom" },
      { "name": "AUTH", "class_name": "AuthRoom" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CampaignRoom", "AuthRoom"]
    }
  ],
  "r2_buckets": [
    {
      "binding": "NARRATION_AUDIO",
      "bucket_name": "chagidiel-narration"
    }
  ],
  "vars": {
    "DEV_OTP": "false"
  }
}
